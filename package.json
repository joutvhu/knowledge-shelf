{
  "name": "knowledge-shelf",
  "version": "1.1.0",
  "description": "Knowledge Shelf MCP Server — on-demand documentation, templates, and workflow automation for AI",
  "type": "module",
  "bin": {
    "knowledge-shelf": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "bump": "npm version patch --no-git-tag-version && npm install",
    "bump:patch": "npm version patch --no-git-tag-version && npm install",
    "bump:minor": "npm version minor --no-git-tag-version && npm install",
    "bump:major": "npm version major --no-git-tag-version && npm install",
    "local:publish": "node scripts/publish-local.mjs",
    "local:pack": "node scripts/publish-local.mjs --pack-only",
    "local:uninstall": "npm uninstall -g knowledge-shelf"
  },
  "keywords": [
    "mcp",
    "knowledge-base",
    "knowledge-shelf",
    "documentation",
    "ai",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/knowledge-shelf.git"
  },
  "homepage": "https://github.com/joutvhu/knowledge-shelf#readme",
  "bugs": {
    "url": "https://github.com/joutvhu/knowledge-shelf/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "skills",
    "README.md"
  ]
}
